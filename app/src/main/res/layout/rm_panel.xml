<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rm_panel_title"
        android:textColor="@color/rm_orange"
        android:textStyle="bold"
        android:textSize="13sp"
        android:layout_marginBottom="6dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_rostelecom"
                style="@style/RmPresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rm_preset_rostelecom" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_t2"
                style="@style/RmPresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rm_preset_t2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_megafon"
                style="@style/RmPresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rm_preset_megafon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_yota"
                style="@style/RmPresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rm_preset_yota" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_universal"
                style="@style/RmPresetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rm_preset_universal" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rm_auto_button"
            style="@style/RmActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/rm_auto_pick" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rm_tg_button"
            style="@style/RmSecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/rm_tg_help" />

    </LinearLayout>

</LinearLayout>
