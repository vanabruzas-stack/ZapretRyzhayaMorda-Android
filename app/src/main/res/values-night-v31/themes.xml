<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Запрет Рыжая морда: фирменная тёмная тема (mapper design).
         БЕЗ DynamicColors — брендовый оранжевый не должен перекрашиваться
         системной палитрой Material You -->
    <style name="Theme.ByeDPI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:navigationBarColor">@color/rm_bg</item>
        <item name="android:statusBarColor">@color/rm_bg</item>
        <item name="android:windowBackground">@color/rm_bg</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="colorPrimary">@color/rm_orange</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/rm_orange_dark</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSecondary">@color/rm_orange</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">@color/rm_surface</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B3B3B3</item>
        <item name="colorSurfaceContainer">@color/rm_surface</item>
        <item name="colorSurfaceVariant">@color/rm_surface</item>

        <item name="colorControlActivated">@color/rm_orange</item>
        <item name="colorControlHighlight">#33EB732F</item>

        <item name="alertDialogTheme">@style/CustomAlertDialog</item>

        <item name="android:textAppearanceListItem">@style/TextPrimary</item>
        <item name="android:textAppearanceListItemSecondary">@style/TextSummary</item>
        <item name="android:textAppearanceListItemSmall">@style/TextSummary</item>

        <item name="switchPreferenceStyle">@style/App.Preference.SwitchPreference</item>
        <item name="materialCardViewStyle">@style/SmallShadowCard</item>
    </style>

    <style name="AppToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/rm_bg</item>
        <item name="titleTextColor">#FFFFFF</item>
    </style>

    <style name="SmallShadowCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/rm_surface</item>
    </style>

    <style name="CircleButton" parent="Widget.Material3.Button.Icon">
        <item name="cornerRadius">60dp</item>
        <item name="android:textSize">0sp</item>
    </style>

    <style name="App.Preference.SwitchPreference" parent="Preference.SwitchPreference.Material">
        <item name="android:widgetLayout">@layout/material_switch</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/material_alert</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextPrimary" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextSummary" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PillCard">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
